# --- Обязательно ------------------------------------------------------------

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Токен Apify: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Ваш Telegram ID (через запятую, если пользователей несколько).
# Не знаете ID — запустите бота с пустым значением и напишите ему /start, он пришлёт ID.
ALLOWED_USER_IDS=

# Ключ Polza.ai для разбора роликов и расшифровки речи: https://polza.ai/dashboard/api-keys
# Без него бот покажет только статистику.
POLZA_API_KEY=

# Прокси, если Telegram или Instagram у вас не открываются без VPN. Через него пойдут
# связь бота с Telegram и скачивание роликов (Polza — напрямую).
# Не нужен, если VPN включён на весь компьютер. Возьмите адрес из настроек VPN-клиента, например:
#   PROXY=socks5://127.0.0.1:10808      или      PROXY=http://user:pass@host:port
PROXY=

# --- Подборка ---------------------------------------------------------------

# Темы через запятую: с # — хэштег, без # — поисковый запрос (в Reels тоже станет хэштегом).
# Можно поменять прямо в боте командой /topics.
TOPICS=#нейросети,#нейросеть,#искусственныйинтеллект,#chatgpt,#aitools,нейросети для работы
# Площадки: tiktok,instagram
FEED_PLATFORMS=tiktok,instagram
# Ролики не старше N дней
FEED_DAYS=7
# Сколько роликов в одной подборке
FEED_SIZE=10
# Минимум просмотров (если площадка их отдаёт) и лайков (если просмотров нет)
FEED_MIN_VIEWS=20000
FEED_MIN_LIKES=500
# Сколько роликов собирать по каждой теме (влияет на расход Apify)
FEED_RESULTS_PER_TOPIC=30
# Ежедневная подборка в это время (ЧЧ:ММ). Пусто — выключено.
DIGEST_TIME=10:00
TIMEZONE=Europe/Moscow

# --- Разбор аккаунта ----------------------------------------------------------

# Сколько последних роликов собирать
PROFILE_VIDEOS=40
# Сколько лучших роликов разбирать подробно (с кадрами и речью)
ANALYZE_TOP=5
# Кадров на ролик (первые секунды + середина + конец)
FRAMES_PER_VIDEO=6

# --- Нейросеть (Polza.ai) ---------------------------------------------------------

# Модель для разбора — должна понимать картинки. Список моделей: https://polza.ai/api/v1/models
#   anthropic/claude-sonnet-5.5 — быстрый и недорогой разбор (по умолчанию)
#   anthropic/claude-opus-5.5   — самый глубокий разбор, примерно вдвое дороже
#   google/gemini-3.8-flash     — самый дешёвый вариант
LLM_MODEL=anthropic/claude-sonnet-5.5
# Глубина размышлений: low / medium / high / xhigh / max. Пусто — по умолчанию модели.
LLM_REASONING_EFFORT=high
# Модель распознавания речи для роликов без субтитров (почти все Reels). Пусто — выключено.
#   openai/gpt-4o-mini-transcribe — ~0,35 ₽ за минуту, хорошо понимает русский
#   openai/whisper-large-v3-turbo — ~0,05 ₽ за минуту
TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe
# Адрес API. Подойдёт любой OpenAI-совместимый сервис.
LLM_BASE_URL=https://polza.ai/api/v1

# --- Apify (обычно менять не нужно) -------------------------------------------

APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_INSTAGRAM_PROFILE_ACTOR=apify/instagram-reel-scraper
APIFY_INSTAGRAM_HASHTAG_ACTOR=apify/instagram-hashtag-scraper
APIFY_INSTAGRAM_POST_ACTOR=apify/instagram-scraper
# Потолок расходов на один запуск актора, $
APIFY_MAX_CHARGE_USD=2
# Дополнительные поля входа акторов (JSON), если захотите тонкую настройку
APIFY_TIKTOK_EXTRA_INPUT=
APIFY_INSTAGRAM_PROFILE_EXTRA_INPUT=
APIFY_INSTAGRAM_HASHTAG_EXTRA_INPUT=

DB_PATH=data/bot.sqlite3
